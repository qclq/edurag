APP_NAME=智慧校园知识库问答系统
APP_DESCRIPTION=Campus AI Knowledge Base
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+pg8000://edurag:edurag@localhost:5432/edurag
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_HOURS=24
REMEMBER_SESSION_DAYS=30
COOKIE_SECURE=false

# 文件存储：local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=edurag-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# 后台任务：celery | inline（inline 仅建议测试/调试）
TASK_DISPATCH_MODE=celery

# Milvus Standalone
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_DATABASE=default
MILVUS_COLLECTION_PREFIX=edurag_chunks
MILVUS_COLLECTION_ALIAS=edurag_chunks_current

# Qwen Embedding（阿里云百炼 OpenAI 兼容接口）
# 若使用工作空间专属地址，替换为：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_PROVIDER=qwen
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10

# DeepSeek 问答
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=300
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=15

# disabled | oidc | cas
SSO_PROVIDER=disabled
SSO_AUTO_PROVISION=false
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CAS_BASE_URL=
SSO_SCOPES=openid profile email
