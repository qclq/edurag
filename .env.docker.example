# Docker Compose 对外 Web 端口
WEB_PORT=8080

# PostgreSQL（仅 Docker 内网可访问）
POSTGRES_DB=edurag
POSTGRES_USER=edurag
POSTGRES_PASSWORD=edurag

# 生产环境必须替换为随机生成的长密钥，并启用 HTTPS/Secure cookie
SECRET_KEY=replace-with-at-least-32-random-characters
ENVIRONMENT=development
COOKIE_SECURE=false

# disabled | oidc | cas
SSO_PROVIDER=disabled

# Qwen Embedding（阿里云百炼）与 DeepSeek 使用独立密钥
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
QWEN_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen-vl-ocr-latest
LIBREOFFICE_BINARY=soffice
OFFICE_CONVERSION_TIMEOUT_SECONDS=120
# 文档处理并发数限制为 1-3；默认 3，可在小内存服务器上调低。
CELERY_WORKER_CONCURRENCY=3
CELERY_MAX_TASKS_PER_CHILD=20
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
